# OmniX 4-thruster X-frame boat - REAL vehicle parameter set
# Import this in QGC (Parameters -> Load from file) after flashing ardurover.
# This is the real-vehicle version: no SITL-only parameters.

# --- Frame ---
# FRAME_CLASS 2 = Boat
FRAME_CLASS 2
# FRAME_TYPE 2 = OmniX (4 angled thrusters)
FRAME_TYPE 2

# --- Loiter behaviour ---
# LOIT_TYPE 2 = always face stern towards target point, so the vehicle
# reverses / translates instead of turning around.
LOIT_TYPE 2

# --- OmniX lateral translation in autonomous modes ---
# 100 = full lateral thrust available, 0 = disable (fall back to steering only)
OMNI_LAT_PCT 100
# 0 = this boat CANNOT yaw (radial thrusters, no torque).  Autonomous omni
# translation then never commands steering; heading is only measured live and
# the surge/sway split is recomputed every loop from the current GPS heading.
OMNI_YAW_HOLD 0

# --- Heading source: UM982 dual-antenna RTK (no compass installed) ---
# The EKF yaw must come from the GNSS moving-baseline heading, not a compass.
GPS1_TYPE 25           # Unicore moving-baseline NMEA (UM982 dual antenna)
GPS_AUTO_CONFIG 1      # let ArduPilot configure the UM982 (baud 230400)
SERIAL3_PROTOCOL 5     # UART1 = GPS serial port on CUAV V5
SERIAL3_BAUD 230       # 230400, ArduPilot sets this on the UM982
EK3_SRC1_YAW 2         # primary yaw source = GPS (dual-antenna heading)
EK3_SRC2_YAW 8         # secondary yaw source = GSF (only when moving)
# Assumption for the following offsets: UM982's primary/base antenna is at the
# bow (+X), its second antenna is aft (-X), both on the centerline and level
# with each other. The flight controller/IMU is at the hull center.
GPS1_MB_TYPE 1         # custom moving-baseline offset (single dual-antenna GPS)
GPS1_MB_OFS_X 0.60     # primary/front antenna relative to secondary/rear antenna
GPS1_MB_OFS_Y 0
GPS1_MB_OFS_Z 0
GPS1_POS_X 0.30        # primary/front antenna position relative to IMU
GPS1_POS_Y 0
GPS1_POS_Z 0           # replace with measured vertical offset, positive down
# If the UM982 primary/base antenna is the aft antenna instead, change the
# signs: GPS1_MB_OFS_X=-0.60 and GPS1_POS_X=-0.30.

# --- Four thrusters on output channels 1..4 (motor functions 33..36) ---
SERVO1_FUNCTION 33
SERVO1_MIN 1000
SERVO1_MAX 2000
SERVO2_FUNCTION 34
SERVO2_MIN 1000
SERVO2_MAX 2000
SERVO3_FUNCTION 35
SERVO3_MIN 1000
SERVO3_MAX 2000
SERVO4_FUNCTION 36
SERVO4_MIN 1000
SERVO4_MAX 2000

# --- RC input mapping ---
# steering = roll(1), throttle = throttle(3), lateral = yaw(4)
RCMAP_ROLL 1
RCMAP_THROTTLE 3
RCMAP_YAW 4
# lateral channel (yaw stick) centred
RC4_MIN 1000
RC4_TRIM 1500
RC4_MAX 2000

# --- Cruise / mission speed ---
# Set WP_SPEED to the cruise speed you want (m/s). Mission DO_CHANGE_SPEED
# commands override this per leg.
CRUISE_SPEED 1.5
CRUISE_THROTTLE 50
WP_SPEED 1.5
# arrival radius: keep in sync with SHUTTLE_RAD so the stock GUIDED
# arrival and the shuttle arrival agree
WP_RADIUS 1
WP_PIVOT_RATE 60

# --- Two-point shuttle mode ---
SHUTTLE_EN 1
SHUTTLE_RAD 1.0
SHUTTLE_SPD 0.2
SHUTTLE_MIN 0.5
SHUTTLE_MAX 5000
SHUTTLE_CRUISE 1.0
